# build output (regenerated by make)
rom/build/
tools/misc/__pycache__/
firmware/build/
fpga/build/

# toolchain/ also holds the RISC-V compiler fetched by download_toolchain.sh (not in git)
toolchain/xpack-*/
toolchain/iverilog/
toolchain/ghdl/
toolchain/verilator/
toolchain/kicad/
toolchain/verilator-*
toolchain/ghdl-*
toolchain/iverilog-*

# tools/sjasmplus/ is a local copy of the assembler, kept in git (see
# tools/sjasmplus/TURBOACE.md); its own
# .gitignore keeps its build output (build/, the sjasmplus binary) out of git

# build.sh output
release/

# Gowin EDA's output (impl/project_process_config.json, the settings, is kept)
fpga/impl/*
!fpga/impl/project_process_config.json
fpga/*.gprj.user

# Gowin EDA (downloaded by hand, Education Edition)
toolchain/gowim/

# KiCad: generator output and per-user files (the boards themselves are kept)
kicad/*/build/
kicad/*/*.kicad_prl
kicad/*/*-backups/
kicad/*/fp-info-cache
kicad/*/_autosave-*
kicad/*/.history/
kicad/*/~*.lck
__pycache__/
