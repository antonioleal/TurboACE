	(text "Tang Nano 20K on two 1x20 sockets, rows 20.32 mm apart, pin 1 of each at the USB end.\nU1 pins 1-20 = module left header (J6), 21-40 = right header (J5); J1, J2 the sockets (BoM only). PS/2: FPGA 73 (CLK), 74 (DATA).\nU2: Gebildet 4-channel BSS138 level shifter (SparkFun BOB-12009 layout), channels 1-2: a BSS138 each, 10k pull-ups on both sides.\nJ3: PS/2 socket (mini-DIN 6 female, at the board edge): 1 DATA, 3 GND, 4 +5V, 5 CLK, shield to GND."
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bc7cc064-0bee-44bb-865e-8f42fd9c35a1")
	)
